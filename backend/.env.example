# =========================================================
# FinChat Backend - Contoh Konfigurasi Environment
# SALIN file ini menjadi .env lalu isi nilainya sendiri.
# JANGAN pernah commit file .env asli ke Git!
# =========================================================

# Pilihan 1: SQLite lokal (pengembangan cepat, tanpa Docker)
DATABASE_URL=sqlite:///./dompetkuu.db
USE_SQLITE_FALLBACK=true

# Pilihan 2: MySQL/MariaDB via Docker (ganti password sesuai setup Anda)
# DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:<port>/<dbname>
# USE_SQLITE_FALLBACK=false

# Kunci JWT — WAJIB diisi, JANGAN pakai nilai default ini!
# Generate kunci baru: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=GANTI_DENGAN_KUNCI_ACAK_64_KARAKTER

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Environment: development | production
ENVIRONMENT=development
